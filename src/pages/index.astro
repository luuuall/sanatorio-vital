---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Icon from '../components/Icon.astro';
import { porQueElegirnos, site } from '../data/site';
---

<Layout title="Sanatorio Vital — Atención médica integral para toda tu familia">
  <section class="banner">
    <img
      src="/banner.jpg"
      alt="Sanatorio Vital"
      width="1600"
      height="982"
      decoding="async"
      fetchpriority="high"
    />
  </section>

  <Hero />

  <section class="section section-alt" id="porque">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Por qué elegirnos</span>
        <h2 class="section-title">Pensamos la atención pensando en vos</h2>
        <p class="section-sub">
          Cada detalle de nuestro sanatorio está diseñado para que tu experiencia sea simple,
          rápida y humana.
        </p>
      </div>
      <div class="grid grid-2">
        {porQueElegirnos.map((f) => (
          <div class="feature">
            <div class="feature__icon">
              <Icon name={f.icon} size={24} />
            </div>
            <div>
              <h3>{f.title}</h3>
              <p>{f.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="cta">
    <div class="container cta__inner">
      <h2 class="cta__title">Tu salud no puede esperar</h2>
      <p class="cta__sub">
        Sacá tu turno online hoy mismo o escribinos por WhatsApp y te respondemos a la brevedad.
      </p>
      <div class="cta__actions">
        <a href="/contacto" class="btn btn-light">
          <Icon name="calendar" size={18} />
          Sacar mi turno
        </a>
        <a href={site.whatsapp} class="btn btn-accent" target="_blank" rel="noopener">
          <Icon name="whatsapp" size={18} />
          WhatsApp
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .banner {
    position: relative;
    overflow: hidden;
    background: transparent;
  }

  .banner img {
    display: block;
    width: 100%;
    height: auto;
  }

  .feature {
    display: flex;
    gap: 20px;
    background: #fff;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 28px;
    box-shadow: var(--shadow-sm);
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }

  .feature:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
  }

  .feature__icon {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 14px;
    background: var(--brand-600);
    color: #fff;
  }

  .feature h3 {
    font-size: 1.1rem;
    font-weight: 700;
    margin-bottom: 6px;
  }

  .feature p {
    color: var(--ink-soft);
    font-size: 0.94rem;
  }

  .cta {
    position: relative;
    overflow: hidden;
    background: var(--brand-900);
    padding: 80px 0;
  }

  .cta::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle at 80% 20%, rgba(107, 107, 107, 0.25), transparent 45%),
      radial-gradient(circle at 15% 85%, rgba(86, 86, 86, 0.2), transparent 40%);
  }

  .cta__inner {
    position: relative;
    text-align: center;
    max-width: 620px;
  }

  .cta__title {
    color: #fff;
    font-size: clamp(1.9rem, 4vw, 2.6rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    margin-bottom: 16px;
  }

  .cta__sub {
    color: #c6c6c6;
    font-size: 1.05rem;
    margin-bottom: 32px;
  }

  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px;
  }
</style>
