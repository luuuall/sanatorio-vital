---
import Icon from './Icon.astro';
import { site } from '../data/site';

const highlight = [
  'Turnos online 24/7',
  'Obras sociales y prepagas',
  'Historia clínica digital',
  'Resultados de laboratorio online',
];
---

<section class="hero">
  <div class="hero__bg" aria-hidden="true"></div>
  <div class="container hero__inner">
    <div class="hero__content">
      <div class="hero__actions">
        <a href="/contacto" class="btn btn-primary">
          <Icon name="calendar" size={18} />
          Sacar mi turno
        </a>
        <a href="/servicios" class="btn btn-outline">Ver especialidades</a>
      </div>

      <ul class="hero__bullets">
        {highlight.map((item) => (
          <li>
            <Icon name="check" size={16} />
            {item}
          </li>
        ))}
      </ul>
    </div>

    <div class="hero__card">
      <div class="hero__card-top">
        <div class="hero__urg">
          <span class="hero__urg-dot"></span>
          <div>
            <strong>Guardia 24 horas</strong>
            <small>Atención inmediata todo el año</small>
          </div>
        </div>
      </div>

      <div class="hero__quick">
        <p class="hero__quick-title">Turnos para hoy</p>
        <ul>
          <li>
            <span>Clínica médica</span>
            <strong>9:30 hs</strong>
          </li>
          <li>
            <span>Cardiología</span>
            <strong>11:00 hs</strong>
          </li>
        </ul>
      </div>

      <a href={site.phoneHref} class="hero__phone">
        <span class="hero__phone-icon"><Icon name="phone24" size={20} /></span>
        <div>
          <small>Urgencias · 24 horas</small>
          <strong>{site.phone}</strong>
        </div>
      </a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding: 88px 0 72px;
    background: linear-gradient(160deg, #f6f6f6 0%, #ebebeb 55%, #e1e1e1 100%);
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image: radial-gradient(
        circle at 85% 15%,
        rgba(86, 86, 86, 0.14),
        transparent 42%
      ),
      radial-gradient(circle at 10% 90%, rgba(107, 107, 107, 0.12), transparent 40%);
  }

  .hero__inner {
    position: relative;
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 64px;
    align-items: center;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-bottom: 32px;
  }

  .hero__bullets {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 10px 24px;
  }

  .hero__bullets li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--ink-soft);
  }

  .hero__bullets svg {
    color: var(--accent);
  }

  .hero__card {
    background: #fff;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    padding: 28px;
    border: 1px solid var(--border);
  }

  .hero__card-top {
    margin-bottom: 24px;
  }

  .hero__urg {
    display: flex;
    align-items: center;
    gap: 14px;
    background: var(--brand-50);
    border: 1px solid var(--brand-100);
    border-radius: var(--radius);
    padding: 16px 18px;
  }

  .hero__urg-dot {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: #e02d3c;
    box-shadow: 0 0 0 5px rgba(224, 45, 60, 0.15);
    animation: blink 1.8s ease-in-out infinite;
    flex-shrink: 0;
  }

  @keyframes blink {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.4;
    }
  }

  .hero__urg strong {
    display: block;
    font-size: 0.98rem;
  }

  .hero__urg small {
    color: var(--ink-soft);
    font-size: 0.85rem;
  }

  .hero__quick {
    border-top: 1px dashed var(--border);
    padding-top: 20px;
    margin-bottom: 20px;
  }

  .hero__quick-title {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-soft);
    margin-bottom: 12px;
  }

  .hero__quick ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }

  .hero__quick li {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.92rem;
  }

  .hero__quick li strong {
    color: var(--brand-600);
    background: var(--brand-50);
    padding: 4px 12px;
    border-radius: 999px;
    font-size: 0.82rem;
  }

  .hero__phone {
    display: flex;
    align-items: center;
    gap: 14px;
    background: var(--brand-900);
    border-radius: var(--radius);
    padding: 16px 18px;
    color: #fff;
    transition: transform 0.15s ease;
  }

  .hero__phone:hover {
    transform: translateY(-2px);
  }

  .hero__phone-icon {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: var(--accent);
    color: #fff;
    flex-shrink: 0;
  }

  .hero__phone small {
    display: block;
    font-size: 0.8rem;
    color: #b1b1b1;
  }

  .hero__phone strong {
    font-size: 1.1rem;
    letter-spacing: 0.02em;
  }

  @media (max-width: 980px) {
    .hero__inner {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .hero__card {
      max-width: 560px;
    }
  }

  @media (max-width: 560px) {
    .hero {
      padding: 56px 0;
    }

    .hero__card {
      padding: 20px;
    }
  }
</style>
