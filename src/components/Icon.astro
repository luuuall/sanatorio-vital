const current = paths[name] ?? paths.plus;
---

<svg
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  class:list={[name === 'phone24' && 'pulse-line']}
>
  <path d={current} />
</svg>

<style>
  @keyframes pulse-ring {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.45;
    }
  }

  .pulse-line {
    animation: pulse-ring 2s ease-in-out infinite;
  }
</style>
