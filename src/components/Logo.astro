---

<span class="logo">
  <svg class="logo__mark" viewBox="0 0 44 44" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <rect width="44" height="44" rx="11" fill="var(--accent)" />
    <path d="M13 22h18M22 13v18" stroke="var(--brand-900)" stroke-width="3.4" stroke-linecap="round" />
  </svg>
  <span class="logo__wordmark">
    <span>Sanatorio</span>
    <span>Vital</span>
  </span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
  }

  .logo__mark {
    display: block;
    width: 44px;
    height: 44px;
    flex-shrink: 0;
  }

  .logo__wordmark {
    display: grid;
    font-weight: 800;
    font-size: 1rem;
    line-height: 1.05;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--ink);
  }
</style>
