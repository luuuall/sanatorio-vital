---
---

<span class="logo">
  <span class="logo__mark" aria-hidden="true"></span>
  <span class="logo__wordmark">
    <span>Sanatorio</span>
    <span>Vital</span>
  </span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    flex-shrink: 0;
  }

  .logo__mark {
    display: block;
    width: 46px;
    height: 46px;
    flex-shrink: 0;
    background-color: var(--cross);
    -webkit-mask: url('/mark.png') no-repeat center / contain;
    mask: url('/mark.png') no-repeat center / contain;
  }

  .logo__wordmark {
    display: grid;
    font-weight: 800;
    font-size: 1rem;
    line-height: 1.05;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--ink);
  }
</style>
